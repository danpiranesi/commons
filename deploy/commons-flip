#!/usr/bin/env bash
# Repoint the Commons booking app's Caddy references from one localhost port to
# another, validate, and reload — atomically. Installed at /usr/local/bin on the
# server and invoked by bin/deploy through a scoped NOPASSWD sudoers rule.
#
# The app may back several Caddy sites (reverse_proxy and forward_auth), so every
# 127.0.0.1:<port> reference is moved together.
#
# Root-owned and restricted to the two known ports, so the NOPASSWD grant can't be
# turned into arbitrary root access.
#
# Usage: commons-flip <from-port> <to-port>
set -euo pipefail

CADDYFILE=/etc/caddy/Caddyfile
FROM="${1:?from-port required}"
TO="${2:?to-port required}"

# Only the two ports we alternate between are allowed, keeping the grant bounded.
case "${FROM}-${TO}" in
  3000-3001|3001-3000) ;;
  *) echo "commons-flip: refusing ${FROM} -> ${TO} (only 3000<->3001)"; exit 2 ;;
esac

tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
sed "s|127.0.0.1:${FROM}|127.0.0.1:${TO}|g" "$CADDYFILE" > "$tmp"

# Validate the candidate before it ever becomes the live config.
caddy validate --config "$tmp" --adapter caddyfile >/dev/null

cp "$CADDYFILE" "${CADDYFILE}.bak"
install -m 0644 "$tmp" "$CADDYFILE"
systemctl reload caddy
echo "commons-flip: ${FROM} -> ${TO} (Caddy reloaded)"
