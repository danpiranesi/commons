#!/usr/bin/env bash
# Zero-downtime blue/green deploy for the Commons booking app.
#
# The host runs Caddy (systemd) as the TLS edge, proxying the app's vhosts to a
# localhost port. Two releases can't share that fixed port, so a plain
# `kamal deploy` can't overlap them. Instead this alternates the app between two
# localhost ports and flips Caddy to the new one only once it is healthy.
#
#   bin/deploy            build, boot on the free port, health-check, flip, and
#                         stop (but keep) the previous release for rollback
#   bin/deploy rollback   restart the kept previous release and flip back to it
#
# The Caddy flip runs through a root-owned, tightly-scoped helper invoked with a
# NOPASSWD sudoers rule — see deploy/README.md for the one-time setup.
#
# Failure is safe: if a new release never turns healthy, or the candidate
# Caddyfile fails validation, Caddy is never flipped and the old release keeps
# serving.
set -euo pipefail

# ── Config ──────────────────────────────────────────────────────────────────
HOST="203.0.113.10"
SSH_KEY="$HOME/.ssh/id_ed25519"
SSH=(ssh -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new "deploy@$HOST")
SERVICE="commons"
IMAGE="ghcr.io/your-github-user/commons"
DOMAIN="booking.example.org"
CADDYFILE="/etc/caddy/Caddyfile"
PORT_A=3000
PORT_B=3001
ENV_FILE=".kamal/apps/${SERVICE}/env/roles/web.env"   # host-relative; uploaded by `kamal env push`
HEALTH_TIMEOUT=120                                     # seconds to wait for /up
KEEP=2                                                 # web containers to retain (current + previous)

cd "$(dirname "$0")/.."

log()  { printf '\n\033[1;32m▸ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m  %s\033[0m\n' "$*"; }
die()  { printf '\n\033[1;31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
remote() { "${SSH[@]}" "$@"; }

# Names of web containers, newest first (optionally filtered by status).
web_containers() { remote "docker ps -a ${1:+--filter status=$1} --filter label=service=${SERVICE} --filter label=role=web --format '{{.Names}}'"; }
# The host port a container publishes for :80 (e.g. 3000).
container_port() { remote "docker port ${1} 80/tcp 2>/dev/null | head -1" | grep -oE '[0-9]+$' || true; }
# The port Caddy currently sends booking.example.org to.
live_port() { remote "awk '/${DOMAIN//./\\.}[[:space:]]*\\{/{f=1} f&&/reverse_proxy/{print;exit}' ${CADDYFILE}" | grep -oE '[0-9]+$' || true; }

wait_healthy() { # <port>
  local port="$1"
  for _ in $(seq 1 $((HEALTH_TIMEOUT/3))); do
    remote "curl -fsS -m 3 http://127.0.0.1:${port}/up >/dev/null 2>&1" && return 0
    sleep 3
  done
  return 1
}

flip() { # <from-port> <to-port>  — repoint every app vhost and reload Caddy
  remote "sudo -n /usr/local/bin/commons-flip $1 $2"
}

# ── Rollback ────────────────────────────────────────────────────────────────
if [ "${1:-}" = "rollback" ]; then
  CURRENT="$(web_containers running | head -1)"
  PREV="$(web_containers exited | head -1)"
  [ -n "$CURRENT" ] || die "No running release found."
  [ -n "$PREV" ]    || die "No previous (stopped) release kept to roll back to."
  CUR_PORT="$(container_port "$CURRENT")"; PREV_PORT="$(container_port "$PREV")"
  [ -n "$PREV_PORT" ] || die "Couldn't determine the previous release's port."
  [ "$PREV_PORT" != "$CUR_PORT" ] || die "Previous and current share a port — refusing."
  log "Rolling back: ${CURRENT} (:${CUR_PORT}) → ${PREV} (:${PREV_PORT})"

  remote "docker start ${PREV} >/dev/null"
  wait_healthy "$PREV_PORT" || { remote "docker stop ${PREV} >/dev/null 2>&1 || true"; die "Previous release didn't come up healthy on :${PREV_PORT}; nothing flipped."; }
  flip "$CUR_PORT" "$PREV_PORT" || die "Caddy flip failed; still serving ${CURRENT} on :${CUR_PORT}."
  remote "docker stop -t 30 ${CURRENT} >/dev/null"
  log "Rolled back to ${PREV} on :${PREV_PORT}. ✔"
  exit 0
fi

# ── Preflight ───────────────────────────────────────────────────────────────
[ -z "$(git status --porcelain)" ] || die "Working tree is dirty — commit or stash before deploying."
VERSION="$(git rev-parse HEAD)"
REF="${IMAGE}:${VERSION}"
NEW_NAME="${SERVICE}-web-${VERSION}"
log "Deploying ${SERVICE} @ ${VERSION:0:12}"

# ── Build, push, and make the image available on the host ───────────────────
log "Building and pushing image…";        bin/kamal build push
log "Logging the host into the registry…"; bin/kamal registry login
log "Pulling ${VERSION:0:12} on the host…"; remote "docker pull ${REF}"

# The role env file (secrets) is uploaded by `kamal deploy` and persists on the
# host. After rotating a secret, run `kamal deploy` once to re-upload it.
log "Checking env/secrets on host…"
remote "test -s ${ENV_FILE}" || die "Host env file ${ENV_FILE} is missing. Seed it once with 'kamal deploy', then re-run bin/deploy."

# ── Work out which port is live and which is free ───────────────────────────
LIVE_PORT="$(live_port)"
[ -n "${LIVE_PORT:-}" ] || die "Couldn't read the current upstream port for ${DOMAIN} in ${CADDYFILE}."
if [ "$LIVE_PORT" = "$PORT_A" ]; then NEW_PORT=$PORT_B; else NEW_PORT=$PORT_A; fi
log "Live on :${LIVE_PORT} — booting new release on :${NEW_PORT}"

CLEAR_ENV="$(ruby -ryaml -e 'YAML.load_file("config/deploy.yml").dig("env","clear").to_h.each { |k,v| print "--env ", k, "=", v.to_s, " " }')"

# ── Boot the new container on the free port (migrations run on boot) ─────────
log "Booting ${NEW_NAME} on 127.0.0.1:${NEW_PORT}…"
remote "docker rm -f ${NEW_NAME} >/dev/null 2>&1 || true"
remote "docker run --detach --restart unless-stopped --name ${NEW_NAME} \
  --network kamal --hostname ${SERVICE}-${NEW_PORT} \
  --env KAMAL_CONTAINER_NAME=${NEW_NAME} --env KAMAL_VERSION=${VERSION} --env KAMAL_HOST=${HOST} \
  ${CLEAR_ENV} --env-file ${ENV_FILE} \
  --log-opt max-size=10m --volume ${SERVICE}_storage:/rails/storage \
  --label service=${SERVICE} --label role=web \
  --publish 127.0.0.1:${NEW_PORT}:80 ${REF}"

# ── Health-check the new container ──────────────────────────────────────────
log "Waiting for /up on :${NEW_PORT} (up to ${HEALTH_TIMEOUT}s; migrations run first)…"
if ! wait_healthy "$NEW_PORT"; then
  warn "New container never became healthy — rolling back."
  remote "docker logs --tail 50 ${NEW_NAME} 2>&1 || true"
  remote "docker rm -f ${NEW_NAME} >/dev/null 2>&1 || true"
  die "Deploy aborted. ${DOMAIN} untouched, still served on :${LIVE_PORT}."
fi
log "New release is healthy."

# ── Flip Caddy to the new port ──────────────────────────────────────────────
log "Pointing the app's vhosts at :${NEW_PORT} and reloading Caddy…"
if ! flip "$LIVE_PORT" "$NEW_PORT"; then
  warn "Caddy flip failed (helper missing, sudo, or validation) — new release is healthy on :${NEW_PORT} but not receiving traffic."
  remote "docker rm -f ${NEW_NAME} >/dev/null 2>&1 || true"
  die "Deploy aborted. ${DOMAIN} untouched, still served on :${LIVE_PORT}. See deploy/README.md for the one-time flip-helper setup."
fi

# ── Stop (keep) the previous release, prune anything older ──────────────────
log "Stopping the previous release (kept for instant rollback)…"
for c in $(web_containers running | grep -v "^${NEW_NAME}$" || true); do
  [ -n "$c" ] && remote "docker stop -t 30 ${c} >/dev/null"
done
# Keep the newest $KEEP web containers (current + previous); remove the rest.
i=0
for c in $(web_containers); do
  i=$((i+1))
  { [ "$i" -le "$KEEP" ] || [ "$c" = "$NEW_NAME" ]; } && continue
  remote "docker rm ${c} >/dev/null 2>&1 || true"
done

log "Deployed ${VERSION:0:12}. ${DOMAIN} now served on :${NEW_PORT}. ✔"
echo "  Rollback (instant): bin/deploy rollback"
