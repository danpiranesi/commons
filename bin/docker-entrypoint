#!/bin/bash -e

# When running the Rails server, prepare the database first. A demo deployment
# starts from a clean slate on every boot instead.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  if [ -n "${DEMO_MODE:-}" ]; then
    DISABLE_DATABASE_ENVIRONMENT_CHECK=1 ./bin/rails db:schema:load db:seed
  else
    ./bin/rails db:prepare
  fi
fi

exec "${@}"
