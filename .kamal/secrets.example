# Copy to .kamal/secrets (ignored by git) and fill in the values.
# Kamal reads this file when deploying; see config/deploy.yml for how each one is used.

RAILS_MASTER_KEY=$(cat config/master.key)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
POSTGRES_PASSWORD=
DISCOURSE_CONNECT_PROVIDER_SECRET=
SMTP_PASSWORD=
