<%# Pinned above the week grid, outside the calendar turbo-frame so it survives
    week navigation. Uses the same status component and end/extend forms as the QR page. %>
<% if @active_booking %>
  <div class="mb-6 max-w-md">
    <div class="text-xs font-medium text-muted uppercase tracking-wider mb-2"><%= t("calendar.active_panel.heading") %></div>

    <%= render(ReservationStatusComponent.new(resource: @active_booking.resource, booking: @active_booking, context: :panel)) do |status| %>
      <% status.with_actions do %>
        <div class="space-y-5">
          <%# Close-transfer call: only when the next person starts within 30 min
              AND both members have a phone on file (degrades to hidden otherwise). %>
          <% if @next_booking && current_user.phone.present? && @next_booking.user.phone.present? %>
            <div class="rounded-md bg-sage/5 border border-sage/15 px-4 py-3">
              <div class="text-sm"><%= t("reservations.handoff.next_up", name: @next_booking.user.name, time: @next_booking.start_at.strftime("%H:%M")) %></div>
              <a href="tel:<%= @next_booking.user.phone.gsub(/\s+/, "") %>" class="mt-1.5 inline-flex items-center gap-1.5 text-sm font-medium text-sage hover:text-sage/80">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <%= t("reservations.handoff.call", phone: @next_booking.user.phone) %>
              </a>
            </div>
          <% end %>

          <%= render "reservations/trip_actions", resource: @active_booking.resource, booking: @active_booking, return_to: root_path %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
