<%# Previous + next trip for a vehicle, so a member can judge remaining charge
    (previous distance) and reach the person who had it / needs it next.
    Locals: resource, reference (Time, default now). %>
<% reference = local_assigns.fetch(:reference, Time.current) %>
<% prev_b = resource.previous_booking(before: reference) %>
<% next_b = resource.next_booking(after: reference) %>

<% if prev_b || next_b %>
  <div class="space-y-3">
    <% if resource.electric? %>
      <p class="text-xs text-muted flex items-start gap-1.5">
        <span>&#9889;</span>
        <span><%= t("neighbour.charge_hint") %></span>
      </p>
    <% end %>

    <% if prev_b %>
      <div class="rounded-lg border border-card-border bg-white px-4 py-3">
        <div class="text-[11px] font-medium text-muted uppercase tracking-wider mb-1.5"><%= t("neighbour.previous_label") %></div>
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <div class="text-sm font-medium"><%= prev_b.user.name %></div>
            <div class="text-xs text-muted mt-0.5">
              <% if prev_b.status == "returned" %>
                <% if prev_b.km_driven %><span class="text-primary font-medium"><%= number_with_delimiter(prev_b.km_driven) %> km</span><% end %>
                <% if prev_b.destination.present? %><span><%= "· → #{prev_b.destination}" %></span><% end %>
                <div><%= t("neighbour.returned_at", time: prev_b.completed_at&.strftime("%a %-d %b, %H:%M")) %></div>
              <% else %>
                <span><%= t("neighbour.in_use_now") %></span>
                <% if prev_b.destination.present? %><span>· → <%= prev_b.destination %></span><% end %>
                <div><%= prev_b.start_at.strftime("%a %-d %b, %H:%M") %> → <%= prev_b.end_at.strftime("%H:%M") %></div>
              <% end %>
            </div>
          </div>
        </div>
        <% unless prev_b.user == current_user %>
          <%= render "shared/contact_actions", user: prev_b.user, resource: resource %>
        <% end %>
      </div>
    <% end %>

    <% if next_b %>
      <div class="rounded-lg border border-card-border bg-white px-4 py-3">
        <div class="text-[11px] font-medium text-muted uppercase tracking-wider mb-1.5"><%= t("neighbour.next_label") %></div>
        <div class="min-w-0">
          <div class="text-sm font-medium"><%= next_b.user.name %></div>
          <div class="text-xs text-muted mt-0.5">
            <%= next_b.start_at.strftime("%a %-d %b, %H:%M") %> → <%= next_b.end_at.strftime("%H:%M") %>
            <% if next_b.destination.present? %><span>· → <%= next_b.destination %></span><% end %>
          </div>
        </div>
        <% unless next_b.user == current_user %>
          <%= render "shared/contact_actions", user: next_b.user, resource: resource %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
