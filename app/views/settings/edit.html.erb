<%= render(PageHeaderComponent.new(title: t("settings.title"))) %>

<div class="max-w-md">
  <%= form_with model: current_user, url: settings_path, method: :patch, class: "space-y-6" do |f| %>
    <div>
      <%= f.label :locale, t("settings.language"), class: "block text-sm font-medium text-primary mb-1" %>
      <%= f.select :locale,
            I18n.available_locales.map { |loc| [t("languages.#{loc}"), loc] },
            {},
            class: "form-select w-full" %>
    </div>

    <div>
      <div class="block text-sm font-medium text-primary mb-1"><%= t("settings.receipts.label") %></div>
      <label class="flex items-start gap-3 cursor-pointer">
        <%= f.check_box :receipt_opt_out, class: "mt-0.5 rounded border-card-border text-sage focus:ring-sage/30" %>
        <span class="text-sm text-primary">
          <%= t("settings.receipts.opt_out") %>
          <span class="block text-xs text-muted mt-0.5"><%= t("settings.receipts.opt_out_hint") %></span>
        </span>
      </label>
    </div>

    <div>
      <button type="submit" class="inline-flex items-center px-4 py-2 bg-sage text-white text-sm font-medium rounded-md hover:bg-sage/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2">
        <%= t("settings.save") %>
      </button>
    </div>
  <% end %>

  <div class="mt-8 pt-6 border-t border-card-border">
    <%= link_to t("settings.view_usage"), usage_path,
        class: "inline-flex items-center gap-2 text-sm font-medium text-sage hover:text-sage/80" %>
  </div>

  <div class="mt-6">
    <%= button_to t("header.logout"), logout_path, method: :delete,
        class: "inline-flex items-center px-4 py-2 border border-card-border bg-white text-primary text-sm font-medium rounded-md hover:bg-hover transition-colors" %>
  </div>
</div>
