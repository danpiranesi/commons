<% content_for(:title, @resource.display_name) %>

<div class="max-w-md mx-auto px-4 py-8">
  <%= render(FlashComponent.new(flash: flash)) %>

  <%= render(ReservationStatusComponent.new(
    resource: @resource, booking: @booking, recent_booking: @recent_booking,
    upcoming_booking: @upcoming_booking, context: :qr
  )) do |status| %>
    <% if @booking %>
      <% status.with_actions do %>
        <%= render "reservations/trip_actions", resource: @resource, booking: @booking %>
      <% end %>
    <% end %>
  <% end %>

  <% if @booking %>
    <p class="text-center text-xs text-muted mt-4"><%= t("reservations.status.not_you") %></p>
  <% end %>
</div>
