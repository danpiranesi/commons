<%= render(PageHeaderComponent.new(
  title: @user.name,
  subtitle: @user.email,
  breadcrumbs: [[t("admin.users.index.title"), admin_users_path], [@user.name, nil]]
)) %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">

    <%= form_with model: [:admin, @user], method: :patch, class: "space-y-6" do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-danger/10 text-danger text-sm rounded-md px-4 py-3 border border-danger/20" role="alert">
          <ul class="list-disc list-inside">
            <% @user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        </div>
      <% end %>

      <section class="bg-white rounded-lg border border-card-border shadow-sm">
        <div class="px-5 py-4 border-b border-card-border">
          <h2 class="text-sm font-medium"><%= t("admin.users.edit.contact_title") %></h2>
        </div>
        <div class="divide-y divide-card-border">
          <%= render(SettingRowComponent.new(label: t("admin.users.edit.name_label"),
                description: (@user.name_set_by_admin? ? t("admin.users.edit.name_hint_pinned") : t("admin.users.edit.name_hint_forum")),
                tooltip: t("admin.users.edit.name_tooltip"))) do |row| %>
            <% row.with_control do %>
              <%= f.text_field :name, class: "form-input w-56", autocomplete: "off" %>
            <% end %>
          <% end %>
          <%= render(SettingRowComponent.new(label: t("admin.users.edit.phone_label"), tooltip: t("admin.users.edit.phone_tooltip"))) do |row| %>
            <% row.with_control do %>
              <%= f.text_field :phone, class: "form-input w-44 font-mono", placeholder: "e.g. 12 34 56 78", inputmode: "tel" %>
            <% end %>
          <% end %>
          <%= render(SettingRowComponent.new(label: t("admin.users.edit.username_label"), description: t("admin.users.edit.username_hint"))) do |row| %>
            <% row.with_control do %>
              <%= f.text_field :username, class: "form-input w-44", placeholder: "f.eks. alice" %>
            <% end %>
          <% end %>
          <%= render(SettingRowComponent.new(label: t("admin.users.edit.initials_label"), description: t("admin.users.edit.initials_hint"), tooltip: t("admin.users.edit.initials_tooltip"))) do |row| %>
            <% row.with_control do %>
              <%= f.text_field :initials, class: "form-input w-44", placeholder: "e.g. Kim Ha." %>
            <% end %>
          <% end %>
          <%= render(SettingRowComponent.new(label: t("admin.users.edit.housing_unit_label"), tooltip: t("admin.users.edit.housing_unit_tooltip"))) do |row| %>
            <% row.with_control do %>
              <%= f.text_field :housing_unit, class: "form-input w-56", placeholder: "e.g. Hus 3, 1. sal" %>
            <% end %>
          <% end %>
        </div>
      </section>

      <section class="bg-white rounded-lg border border-card-border shadow-sm">
        <div class="px-5 py-4 border-b border-card-border">
          <h2 class="text-sm font-medium"><%= t("admin.users.edit.accounting_title") %></h2>
          <p class="text-xs text-muted mt-0.5"><%= t("admin.users.edit.accounting_hint") %></p>
        </div>
        <div class="divide-y divide-card-border">
          <%= render(SettingRowComponent.new(label: t("admin.users.edit.accounting_account_label"), tooltip: t("admin.users.edit.accounting_account_tooltip"))) do |row| %>
            <% row.with_control do %>
              <%= f.text_field :accounting_account, class: "form-input w-32 font-mono", placeholder: "e.g. 4210" %>
            <% end %>
          <% end %>
          <%= render(SettingRowComponent.new(label: t("admin.users.edit.accounting_name_label"), description: t("admin.users.edit.accounting_name_hint"), tooltip: t("admin.users.edit.accounting_name_tooltip"))) do |row| %>
            <% row.with_control do %>
              <%= f.text_field :accounting_name, class: "form-input w-56", placeholder: @user.name %>
            <% end %>
          <% end %>
        </div>
      </section>

      <section class="bg-white rounded-lg border border-card-border shadow-sm">
        <div class="px-5 py-4 border-b border-card-border">
          <h2 class="text-sm font-medium"><%= t("admin.users.edit.membership_title") %></h2>
        </div>
        <div class="divide-y divide-card-border">
          <%= render(SettingRowComponent.new(label: t("admin.users.edit.billing_category_label"), description: t("admin.users.edit.billing_category_hint"), tooltip: t("admin.users.edit.billing_category_tooltip"))) do |row| %>
            <% row.with_control do %>
              <%= f.collection_select :billing_category_id, BillingCategory.personal, :id,
                    ->(c) { c.rate_value.to_f == 1.0 ? c.name_da : "#{c.name_da} (×#{c.rate_value.to_f})" },
                    { prompt: t("admin.users.edit.billing_category_prompt") }, class: "form-select w-64" %>
            <% end %>
          <% end %>
          <%# Personligt erhverv is normally Members-only, since the charge is
              deducted from salary. This grants it to someone else deliberately. %>
          <%= render(SettingRowComponent.new(label: t("admin.users.edit.business_override_label"),
                description: t("admin.users.edit.business_override_hint"))) do |row| %>
            <% row.with_control do %>
              <label class="flex items-center gap-2 cursor-pointer">
                <%= f.check_box :business_override, class: "rounded border-card-border text-sage focus:ring-sage/30" %>
                <span class="text-sm text-muted"><%= t("admin.users.edit.business_override_toggle") %></span>
              </label>
            <% end %>
          <% end %>
          <%= render(SettingRowComponent.new(label: t("admin.users.edit.user_type_label"), description: t("admin.users.edit.user_type_hint"), tooltip: t("admin.users.edit.user_type_tooltip"))) do |row| %>
            <% row.with_control do %>
              <%= f.select :user_type, User::USER_TYPES.map { |t| [t.capitalize, t] }, {}, class: "form-select w-44" %>
            <% end %>
          <% end %>
        </div>
      </section>

      <%# Working hours — the windows this member's assigned car (fast bruger) is
          held for them. Leave a day blank if they don't need the car that day. %>
      <section class="bg-white rounded-lg border border-card-border shadow-sm">
        <div class="px-5 py-4 border-b border-card-border">
          <h2 class="text-sm font-medium"><%= t("admin.users.edit.working_hours_title") %></h2>
          <p class="text-xs text-muted mt-0.5">
            <%= t("admin.users.edit.working_hours_hint") %>
            <% if @user.regular_for_resources.any? %>
              <span class="text-primary"><%= t("admin.users.edit.working_hours_cars", cars: @user.regular_for_resources.map(&:display_name).join(", ")) %></span>
            <% end %>
          </p>
        </div>
        <div class="p-5 space-y-2">
          <% %w[Mandag Tirsdag Onsdag Torsdag Fredag Lørdag Søndag].each_with_index do |day, i| %>
            <% cwday = i + 1 %>
            <% wh = @user.working_hours_for(cwday) %>
            <div class="flex items-center gap-3">
              <span class="w-24 text-sm text-primary"><%= day %></span>
              <input type="time" name="user[working_hours][<%= cwday %>][start]" value="<%= wh&.dig("start") %>" step="1800" class="form-input w-32">
              <span class="text-muted">–</span>
              <input type="time" name="user[working_hours][<%= cwday %>][end]" value="<%= wh&.dig("end") %>" step="1800" class="form-input w-32">
            </div>
          <% end %>
        </div>
      </section>

      <div class="flex items-center gap-3">
        <%= render(ButtonComponent.new(type: "submit", variant: :primary)) { t("admin.users.edit.save_button") } %>
        <%= render(ButtonComponent.new(href: admin_users_path, variant: :ghost)) { t("admin.users.edit.cancel_button") } %>
      </div>
    <% end %>
  </div>

  <div class="space-y-4">
    <%= render(CardComponent.new) do |card| %>
      <% card.with_header { t("admin.users.edit.info_title") } %>
      <dl class="text-sm space-y-3">
        <div>
          <dt class="text-xs text-muted mb-0.5">Email</dt>
          <dd><%= @user.email %></dd>
        </div>
        <% if @user.discourse_id.present? %>
          <div>
            <dt class="text-xs text-muted mb-0.5"><%= t("admin.users.edit.discourse_label") %></dt>
            <dd class="font-mono text-xs"><%= @user.discourse_id %></dd>
          </div>
        <% else %>
          <div class="text-xs text-amber-600"><%= t("admin.users.edit.no_discourse") %></div>
        <% end %>
        <% if @user.account %>
          <div>
            <dt class="text-xs text-muted mb-0.5"><%= t("admin.users.edit.balance_label") %></dt>
            <dd><%= number_to_currency(@user.account.transactions.sum(:amount).abs, unit: "", precision: 0) %> DKK</dd>
          </div>
        <% end %>
      </dl>
    <% end %>
  </div>
</div>
