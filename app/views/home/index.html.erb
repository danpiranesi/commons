<h1 class="text-2xl font-medium mb-1"><%= t("home.index.greeting", name: current_user.name) %></h1>
<p class="text-[16px] text-muted mb-8"><%= t("home.index.subtitle") %></p>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <%= render "tile",
    href: "https://forum.example.org",
    title: t("home.tiles.forum.title"),
    description: t("home.tiles.forum.description"),
    icon: forum_icon %>

  <%= render "tile",
    href: "/bookings",
    title: t("home.tiles.bookings.title"),
    description: t("home.tiles.bookings.description"),
    icon: bookings_icon %>

  <%= render "tile",
    href: "/intranet",
    title: t("home.tiles.intranet.title"),
    description: t("home.tiles.intranet.description"),
    icon: intranet_icon %>
</div>
